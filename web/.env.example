# Copy to web/.env and fill in. These values ship to the browser — public keys only.

VITE_API_URL=http://localhost:4100
VITE_SUPABASE_URL=
# anon key (or the newer sb_publishable_ key) — public by design
VITE_SUPABASE_ANON_KEY=
# Same Client ID as the server (the secret stays on the server)
VITE_PAYPAL_CLIENT_ID=
# Optional: true keeps demo mode even when Supabase is configured
VITE_DEMO=
# Must match PLATFORM_FEE_PERCENT on the server (shown in the funding and release dialogs)
VITE_PLATFORM_FEE_PERCENT=2
