# Copy to server/.env and fill in. Never commit the real file.

PORT=4100
# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# PayPal — developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after creating a webhook in the PayPal dashboard (optional on day 1)
PAYPAL_WEBHOOK_ID=

# Supabase — Project Settings → API
SUPABASE_URL=
# service_role key: server only, bypasses row-level security
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com → API keys
ANTHROPIC_API_KEY=
