# Copy to server/.env and fill in. Never commit the real file.

PORT=4100
# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5180,http://127.0.0.1:5180

# PayPal — developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Set after creating a webhook in the PayPal dashboard (optional on day 1)
PAYPAL_WEBHOOK_ID=

# Verdikt's cut, taken from the freelancer's payout (0 turns it off)
PLATFORM_FEE_PERCENT=2

# Supabase — Project Settings → API
SUPABASE_URL=
# service_role key (or the newer sb_secret_ key): server only, bypasses row-level security
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct Postgres connection string, only for running the SQL migrations
SUPABASE_DB_URL=

# Anthropic — console.anthropic.com → API keys (drafts the checks and judges deliveries)
ANTHROPIC_API_KEY=
# Or Claude through OpenRouter (e.g. bring your own Anthropic key there): when set, this is used instead
OPENROUTER_API_KEY=
# Optional: model override (default claude-opus-5-5, or anthropic/claude-opus-5.5 through OpenRouter)
VERDIKT_MODEL=
# Optional: lets the in-browser demo's dashboard assistant reach Claude, up to this many turns a day in all
# (sample data only; each visitor also gets 60 turns an hour). Empty or 0: the demo's assistant stays offline
STUDIO_DEMO_TURNS_PER_DAY=

# Optional: Kernel cloud browsers (kernel.sh). Official verifications run there and are recorded as a video both
# sides can watch; pre-checks and portfolio checks stay on this server's browser. Empty: everything runs locally
KERNEL_API_KEY=
# Most Kernel sessions open at once (default 3); above it a check waits up to a minute, then runs locally
KERNEL_MAX_BROWSERS=
# Optional: Elasticsearch (Elastic Cloud) for precedent: how similar checks were decided before, shown to Claude
# and to both sides. After setting these, run `npm run precedent:sync -- --rebuild --yes` once (it creates the
# index and its alias; the server never does). Empty: no precedent
ELASTIC_URL=
ELASTIC_API_KEY=
# The alias the verifier reads and writes (default verdikt-precedent; the v1 index verdikt-checks is not used)
ELASTIC_INDEX=
# Pinned models: the embeddings behind semantic_text and the reranker (defaults .jina-embeddings-v5-text-small
# and .jina-reranker-v3)
ELASTIC_EMBED=
ELASTIC_RERANKER=
# The reranker's raw relevance a past check needs to count as precedent (default 0.22, see precedent:calibrate)
ELASTIC_PRECEDENT_MIN=
# The most a verdict waits for precedent, in ms (default 4000); past it the verdict goes ahead without
ELASTIC_PRECEDENT_BUDGET_MS=
# off: no precedent search or sync at all (default on when the URL and key are set)
ELASTIC_PRECEDENT=
# on: also leave out other contracts between the same two parties (default off: a solo tester is both parties)
ELASTIC_PRECEDENT_EXCLUDE_PARTIES=
# Optional: Channel3 key for store listings in planned purchases (free, 1,000 searches a month). It turns on the
# REST v1 search and the product lookup that keeps pins across restarts; empty: anonymous MCP search, and an
# item can only be added from a search made in the last 15 minutes
CHANNEL3_API_KEY=
# Channel3's REST API (default https://api.trychannel3.com) and its MCP server, the fallback and the keyless search
# (default https://mcp.trychannel3.com/)
CHANNEL3_API_URL=
CHANNEL3_MCP_URL=
# A soft stop on searches a month (UTC), below the 1,000 free credits; cached repeats and product lookups don't count
CHANNEL3_MONTHLY_CAP=900

# Verifier browser: leave empty to use your installed Chrome; Docker sets /usr/bin/chromium
CHROME_PATH=
# Optional: raises GitHub's rate limit when reading repositories
GITHUB_TOKEN=
